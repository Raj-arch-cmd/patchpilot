# ============================================================
# PatchPilot Backend — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- FalkorDB Connection ---
# Host where FalkorDB (Redis-compatible) is running.
# Use "localhost" for local dev; use "falkordb" inside Docker Compose.
FALKORDB_HOST=localhost

# FalkorDB listens on the standard Redis port by default.
FALKORDB_PORT=6379

# FalkorDB password (leave blank if no auth is configured)
FALKORDB_PASSWORD=

# The name of the FalkorDB graph used by PatchPilot.
FALKORDB_GRAPH=patchpilot

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM Provider ---
# Set to "openai" to enable GPT-based explanations.
# Set to "deterministic" (or leave blank) to run without an LLM.
# In deterministic mode the graph-reasoning and scoring still work fully —
# only the natural-language summary is replaced with a rule-based template.
LLM_PROVIDER=deterministic

# --- OpenAI (only required when LLM_PROVIDER=openai) ---
# Obtain your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (only required when LLM_PROVIDER=anthropic) ---
# Obtain your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Logging ---
LOG_LEVEL=INFO
